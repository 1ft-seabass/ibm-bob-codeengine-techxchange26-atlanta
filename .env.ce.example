# ============================================================
# .env.ce.example — Code Engine デプロイスクリプト用設定のサンプル
# ============================================================
# このファイルをコピーして .env.ce を作成し、実際の値を入力してください。
#
#   cp .env.ce.example .env.ce
#
# .env.ce は Git 管理外です（.gitignore で除外済み）。
# ここに書く値はすべて ibmcloud CLI コマンドで確認できます。
# 取得方法は各項目のコメントを参照してください。
# ============================================================

# ─────────────────────────────────────────────────────────
# CE_BUILD_NAME — Code Engine のビルド名
# ─────────────────────────────────────────────────────────
# 取得方法:
#   ibmcloud target -g default
#   ibmcloud ce project select --name <PROJECT_NAME>
#   ibmcloud ce build list
# → 一覧の「名前」列に表示される値をそのまま入力する
# 例: hono-app-build
CE_BUILD_NAME=your-build-name

# ─────────────────────────────────────────────────────────
# CE_APP_NAME — Code Engine のアプリ名
# ─────────────────────────────────────────────────────────
# 取得方法:
#   ibmcloud ce application list
# → 一覧の「名前」列に表示される値をそのまま入力する
# 例: hono-app
CE_APP_NAME=your-app-name

# ─────────────────────────────────────────────────────────
# CE_BUILD_IMAGE — ビルド成果物のイメージ URL（:latest 付き）
# ─────────────────────────────────────────────────────────
# 取得方法:
#   ibmcloud ce build get --name <CE_BUILD_NAME>
# → 出力の「イメージ:」欄の値に ":latest" を付けて入力する
# 例: private.jp.icr.io/ce--xxxxxx-yyyyyyyyyyyy/build-hono-app-build:latest
#
# ⚠️ 注意: "private." で始まる内部 URL を使う（public URL ではない）
# ⚠️ 注意: タグは必ず ":latest" にする
CE_BUILD_IMAGE=private.YOUR_REGION.icr.io/YOUR_ICR_NAMESPACE/build-YOUR_BUILD_NAME:latest

# -------------------------------------------------------------------
# 任意設定（必要に応じて .env.ce に追加してください）
# -------------------------------------------------------------------

# デプロイ先リージョン（ibmcloud target -r で切り替える場合に使用）
# 例: jp-tok / us-south / eu-de
# IBMCLOUD_TARGET_REGION=jp-tok

# デプロイ先リソースグループ（ibmcloud target -g で切り替える場合に使用）
# IBMCLOUD_TARGET_RESOURCE_GROUP=default

# buildrun submit 時のコミット指定（省略時は build 定義が参照するブランチの最新コミット）
# 指定する場合: ibmcloud ce buildrun submit --build $CE_BUILD_NAME --commit $CE_BUILD_COMMIT --wait
# CE_BUILD_COMMIT=main

# application update 時の CPU・メモリ上書き（通常は省略。スケール調整時に使用）
# CE_APP_CPU=1
# CE_APP_MEMORY=4G
