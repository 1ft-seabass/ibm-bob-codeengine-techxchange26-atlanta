# ============================================================
# .env.example — ローカル開発用 MQTT 接続情報のサンプル
# ============================================================
# このファイルをコピーして .env を作成し、実際の値を入力してください。
#
#   cp .env.example .env
#
# .env は Git 管理外です（.gitignore で除外済み）。
# 本番（Code Engine）用の設定は .env.production に別途用意し、
# npm run env:create / env:update で Secret として登録してください。
# ============================================================

# MQTT ブローカーのホスト名
# 例（HiveMQ Cloud）: xxxxx.s1.eu.hivemq.cloud
# 例（ローカル mosquitto）: localhost
MQTT_HOST=xxxxx.s1.eu.hivemq.cloud

# MQTT ブローカーのポート番号
# mqtts（生MQTT over TLS）の場合: 通常 8883
# wss（MQTT over WebSocket over TLS）の場合: 通常 8884
# ローカル mosquitto（非TLS）の場合: 通常 1883（MQTT_PROTOCOL=mqtt）
MQTT_PORT=8883

# 接続プロトコル
# mqtts — 生MQTT over TLS（HiveMQ Cloud などクラウドブローカーの標準）
# wss   — MQTT over WebSocket over TLS
# mqtt  — 非TLS（ローカルテスト用）
MQTT_PROTOCOL=mqtts

# MQTT 認証情報
# ブローカーの管理画面で発行したユーザー名・パスワードを入力する
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# ============================================================
# IoT デバイス制御トピック
# ============================================================
# POST /api/device/on|off が publish する先のトピック。
# デバイスの MAC アドレスが変わった場合はここを更新してください。
#
# LED (AtomS3, MAC 24587C5C91B8)
# ON payload : {"type":"led","r":255,"g":255,"b":255}
# OFF payload: {"type":"led","r":0,"g":0,"b":0}
MQTT_IOT_CONTROL_LED=atoms3/24587C5C91B8/control/led

# LED2 (AtomS3, MAC 30EDA0CA4718) [optional]
# ON payload : {"type":"led","r":255,"g":255,"b":255}
# OFF payload: {"type":"led","r":0,"g":0,"b":0}
# MQTT_IOT_CONTROL_LED2=atoms3/30EDA0CA4718/control/led

# Servo (AtomS3, MAC D0CF130CC104)
# ON payload : {"direction":"cw","speed":3}
# OFF payload: {"command":"stop"}
MQTT_IOT_CONTROL_SERVO=atoms3/D0CF130CC104/control/servo
