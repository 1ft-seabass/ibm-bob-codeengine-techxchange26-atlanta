{
  "name": "ibm-bob-codeengine-techxchange26-atlanta",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "security": "node .security-check/cli.js",
    "postinstall": "npx simple-git-hooks",
    "start": "node server.js",
    "build:image_build": "node scripts/ce-run.js buildrun",
    "build:update_app": "node scripts/ce-run.js update_app",
    "build:cleanup": "node scripts/ce-cleanup.js",
    "build": "npm run build:image_build && npm run build:update_app && npm run build:cleanup",
    "env:create": "node scripts/ce-run.js ibmcloud ce secret create --name mqtt-secret --from-env-file .env.production",
    "env:update": "node scripts/ce-run.js ibmcloud ce secret update --name mqtt-secret --from-env-file .env.production",
    "env:attach": "node scripts/ce-run.js ibmcloud ce application update --name $CE_APP_NAME --env-from-secret mqtt-secret"
  },
  "simple-git-hooks": {
    "pre-commit": "node .security-check/cli.js pre-commit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1ft-seabass/ibm-bob-codeengine-techxchange26-atlanta.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/1ft-seabass/ibm-bob-codeengine-techxchange26-atlanta/issues"
  },
  "homepage": "https://github.com/1ft-seabass/ibm-bob-codeengine-techxchange26-atlanta#readme",
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "dotenv": "^18.0.4",
    "hono": "^4.0.0",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "dotenv-cli": "^11.0.0",
    "secretlint": "^13.0.6",
    "simple-git-hooks": "^2.0.0"
  }
}
